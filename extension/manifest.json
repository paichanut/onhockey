{
  "manifest_version": 3,
  "name": "OnHockey Live Helper",
  "version": "1.0.0",
  "description": "Lets onhockey.vercel.app load the onhockey.tv schedule through your own browser.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["https://onhockey.tv/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://onhockey.vercel.app/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [{ "id": "referer", "enabled": true, "path": "rules.json" }]
  }
}
